{
  "name": "test402-erc20",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "ERC-20 reward token and claim distributor for Base, with mint-on-claim distribution",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:nodejs": "hardhat test nodejs",
    "coverage": "hardhat test --coverage",
    "coverage:check": "hardhat run scripts/check-coverage.ts",
    "lint": "solhint \"contracts/**/*.sol\" \"test/**/*.sol\" && prettier --check .",
    "format": "prettier --write .",
    "check-deployment": "hardhat run scripts/check-deployment.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.20.1",
    "forge-std": "https://github.com/foundry-rs/forge-std/archive/refs/tags/v1.9.4.tar.gz",
    "hardhat": "^3.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.4",
    "typescript": "~6.0.3",
    "viem": "^2.55.19"
  }
}
