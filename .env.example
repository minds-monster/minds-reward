# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Hardhat 3 resolves these through `configVariable()`, which reads either the
# environment or the encrypted keystore. For anything secret, prefer the keystore:
#
#   npx hardhat keystore set BASE_SEPOLIA_PRIVATE_KEY
#
# A plaintext key in .env is the MVP compromise recorded in ADR-010 and ranked as the
# project's sharpest risk (architecture §11, risk 1). It is acceptable on testnet, where
# the tokens are worthless. It is NOT acceptable on mainnet: the mainnet gate requires
# keys out of plaintext and a key that is never the testnet key.

# --- Base Sepolia (testnet, the MVP target) ---
BASE_SEPOLIA_RPC_URL=https://<your-provider-endpoint>

# --- Base mainnet (later; gated on architecture §11) ---
BASE_MAINNET_RPC_URL=https://<your-provider-endpoint>

# Path to the Ignition parameters file used by the post-deploy check.
# Optional — defaults to ignition/parameters.json.
# IGNITION_PARAMETERS=ignition/parameters.json

# --- secrets ---
# Never commit real values for anything below this line.

# Deployer/operator key for Base Sepolia. Prefer the keystore over this file.
BASE_SEPOLIA_PRIVATE_KEY=0x<64-hex-characters>

# Deployer/operator key for Base mainnet. Must be a distinct, separately funded key —
# never the testnet key (architecture §11, mainnet gate item 4).  # mainnet only
BASE_MAINNET_PRIVATE_KEY=0x<64-hex-characters>

# Etherscan API v2 key (https://etherscan.io/apidashboard). Hardhat 3 verify uses
# Etherscan API v2, which is one key for every supported chain including Base
# Sepolia. A legacy basescan.org-only key is rejected as "Invalid API Key (#err2)".
# Used for BaseScan source verification (FR-DEPLOY-004, NFR-CMP-002).
BASESCAN_API_KEY=<your-etherscan-api-v2-key>
